{
    "name": "ewk/moonshine-media",
    "description": "Media library for Laravel with a MoonShine 4 admin: folders, variants, usages, attachments, a picker field and a gallery field.",
    "type": "library",
    "keywords": [
        "laravel",
        "moonshine",
        "media",
        "media-library",
        "uploads",
        "images",
        "attachments",
        "admin"
    ],
    "homepage": "https://github.com/einzelwerk/moonshine-media",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/einzelwerk/moonshine-media/issues",
        "source": "https://github.com/einzelwerk/moonshine-media"
    },
    "authors": [
        {
            "name": "Dimitrienko Vadim",
            "email": "vd@ewk.agency"
        }
    ],
    "require": {
        "php": "^8.4",
        "enshrined/svg-sanitize": "^1.0",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "intervention/image": "^3.0",
        "moonshine/moonshine": "^4.19",
        "ramsey/uuid": "^4.7",
        "symfony/http-foundation": "^7.0|^8.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "larastan/larastan": "^3.13",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ewk\\Cms\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ewk\\Cms\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ewk\\Cms\\Media\\CmsMediaServiceProvider",
                "Ewk\\Cms\\Media\\MoonShine\\MoonShineMediaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest",
        "test:arch": "pest tests/Arch",
        "test:unit": "pest tests/Unit tests/MoonShine/Unit",
        "test:feature": "pest tests/Feature tests/MoonShine/Feature",
        "format": "php-cs-fixer fix --allow-risky=yes",
        "format:dry": "php-cs-fixer fix --allow-risky=yes --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "rector": "rector process",
        "rector:dry": "rector process --dry-run"
    }
}
